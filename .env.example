# Runtime service only. Never commit populated files or use NEXT_PUBLIC for these.
APP_URL=
DATABASE_URL=
DATABASE_CA_CERT=
BETTER_AUTH_SECRET=
STRIDE_ALLOWED_EMAILS=

# Dedicated migration/provisioning service only; never give these to the web app.
MIGRATION_DATABASE_URL=
STRIDE_RUNTIME_PASSWORD=
STRIDE_BOOTSTRAP_EMAIL=
STRIDE_BOOTSTRAP_NAME=
STRIDE_BOOTSTRAP_PASSWORD=

# Web app and scheduled worker: optional private S3-compatible file storage.
STRIDE_S3_ENDPOINT=
STRIDE_S3_BUCKET=
STRIDE_S3_REGION=
STRIDE_S3_ACCESS_KEY_ID=
STRIDE_S3_SECRET_ACCESS_KEY=

# Web app and worker: verified Resend sender. Missing values disable delivery.
RESEND_API_KEY=
STRIDE_EMAIL_FROM=

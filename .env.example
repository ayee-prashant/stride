# Server variables only. Configure independent values for preview and production.
APP_URL=
DATABASE_URL=
# PEM CA certificate for verified TLS to Railway; no SSL query parameters in URL.
DATABASE_CA_CERT=
# Generate at least 32 random bytes in the host's secret store.
BETTER_AUTH_SECRET=
# A dedicated GitHub OAuth application; callback APP_URL/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub account IDs. Initial owner: 259055605. No public enrollment.
STRIDE_ALLOWED_GITHUB_IDS=259055605
# Migration job only. Do not grant schema privileges to the runtime database role.
MIGRATION_DATABASE_URL=
